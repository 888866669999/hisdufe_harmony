/*
 * CaptchaCharset：ddddocr 模型的字符表（仅保留字母与数字）
 *
 * ===== 为什么需要一张字符表 =====
 * ddddocr 的识别模型（CRNN + CTC）输出的不是「字符」，而是
 * **8210 个类别的索引**。要把索引变回字符，必须查它训练时用的字符表。
 * 这里只保留其中的 ASCII 字母与数字（共 62 项）—— 本验证码只会出现这些字符，
 * 完整表含 2 万多个汉字，全量内置既没有必要也会白白撑大包体。
 *
 * ===== 索引为什么不能省 =====
 * 索引是模型输出的**绝对值**，不能压缩重排：模型给出 2376 就必须查 2376 → 'r'。
 * 因此这里保留原索引，只做「稀疏映射」，而不是建一个 0..61 的紧凑数组。
 *
 * 数据来源：ddddocr（MIT 许可）的 charsets.py 中 CHARSET_BETA，
 * 按 `len(c)==1 && c.isascii() && c.isalnum()` 过滤得到。
 */
export class CaptchaCharset {
  /** [索引, 字符] 稀疏表 */
  private static readonly PAIRS: number[][] = [
    [13, 54], [55, 102], [209, 112], [210, 76], [297, 89], [306, 119],
    [309, 51], [311, 70], [320, 109], [521, 88], [598, 71], [689, 120],
    [782, 105], [897, 84], [901, 78], [1073, 118], [1151, 99], [1204, 66],
    [1503, 110], [1849, 81], [1965, 72], [2113, 75], [2185, 87], [2341, 80],
    [2376, 114], [2457, 108], [2547, 69], [2621, 90], [2714, 115], [2851, 50],
    [3073, 122], [3128, 68], [3157, 79], [3606, 52], [4018, 49], [4102, 116],
    [4393, 98], [4429, 111], [4588, 117], [4725, 57], [4730, 106], [4733, 48],
    [4919, 56], [5223, 53], [5428, 101], [5461, 65], [5629, 82], [5690, 103],
    [5737, 107], [5855, 83], [6554, 73], [6794, 55], [6810, 100], [6887, 86],
    [7216, 74], [7266, 97], [7412, 104], [7576, 113], [7712, 85], [7844, 77],
    [7877, 121], [7961, 67]
  ];

  /** 索引 → 字符；命中不到返回空（含 CTC 的 blank=0） */
  static charOf(index: number): string {
    if (index <= 0) {
      return '';
    }
    for (let i = 0; i < CaptchaCharset.PAIRS.length; i++) {
      if (CaptchaCharset.PAIRS[i][0] === index) {
        return String.fromCharCode(CaptchaCharset.PAIRS[i][1]);
      }
    }
    return '';
  }

  /** 类别总数（模型输出维度，用于校验） */
  static readonly CLASS_COUNT: number = 8210;

  /**
   * CTC 贪心解码。
   *
   * 规则（与 ddddocr 的 `_ctc_decode_indices` 一致）：
   *   1. 合并连续重复索引（CTC 的经典折叠）；
   *   2. 丢弃 blank（索引 0）；
   * 再查表转字符。**不做易混字符纠正**：模型自己的判断比后处理替换更可信，
   * 擅自把 1↔l、0↔O 互换只会在原本正确时引入错误。
   */
  static decode(indices: number[]): string {
    let out: string = '';
    let prev: number = -1;
    for (let i = 0; i < indices.length; i++) {
      const idx: number = indices[i];
      if (idx !== prev && idx !== 0) {
        out = out + CaptchaCharset.charOf(idx);
      }
      prev = idx;
    }
    return out;
  }
}